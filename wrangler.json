{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "290-playground",
  "main": "./worker/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
